  #!/bin/bash
# ==========================================================
# SupportDesk-Web-App — Git-based Deploy Script
# Server par chalane ke liye: bash deploy.sh
# ==========================================================

set -e  # koi bhi command fail ho to script turant ruk jaye

# ---- CONFIG: apne hisaab se ye 3 lines edit karo ----
PROJECT_DIR="/home/YOUR_SITE_USER/htdocs/SupportDesk-Web-App"
GIT_BRANCH="main"
PM2_APP_NAME="supportdesk-api"
# ------------------------------------------------------

echo ""
echo "🚀 Deploy shuru ho raha hai — $(date '+%Y-%m-%d %H:%M:%S')"
echo "----------------------------------------------------"

cd "$PROJECT_DIR"

echo "📥 [1/5] Latest code GitHub se pull kar rahe hain ($GIT_BRANCH)..."
git fetch origin "$GIT_BRANCH"
git reset --hard "origin/$GIT_BRANCH"

echo "📦 [2/5] Dependencies install kar rahe hain (pnpm)..."
pnpm install

echo "🔨 [3/5] Project build kar rahe hain (backend + frontend)..."
pnpm run build

echo "🔁 [4/5] Backend restart kar rahe hain (PM2)..."
if pm2 describe "$PM2_APP_NAME" > /dev/null 2>&1; then
  pm2 restart "$PM2_APP_NAME"
else
  echo "⚠️  PM2 process '$PM2_APP_NAME' nahi mila — pehli baar start kar rahe hain..."
  cd "$PROJECT_DIR/artifacts/api-server"
  pm2 start dist/index.mjs --name "$PM2_APP_NAME" --node-args="--enable-source-maps"
  pm2 save
  cd "$PROJECT_DIR"
fi

echo "✅ [5/5] Deploy complete!"
echo "----------------------------------------------------"
echo "Frontend build: $PROJECT_DIR/artifacts/supportdesk-web/dist/public"
echo "Backend status:"
pm2 status "$PM2_APP_NAME"
echo ""
echo "🎉 Live site check karo browser mein (hard refresh: Ctrl+Shift+R)"

