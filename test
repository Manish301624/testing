## File 3: `src/cart_lines_discounts_generate_run.js`
```javascript
// @ts-check
import { OrderDiscountSelectionStrategy } from "../generated/api";

/**
 * @typedef {import("../generated/api").CartInput} CartInput
 * @typedef {import("../generated/api").CartLinesDiscountsGenerateRunResult} CartLinesDiscountsGenerateRunResult
 */

const BASE_PRICE = 65000; // ek print ka normal rate

// Sirf ye exact quantities offer ke eligible hain — baaki sab (1,3,5,7+) pe base price hi lagega
const TIER_TOTALS = {
  2: 120000,
  4: 220000,
  6: 300000,
};

const EMPTY_DISCOUNT = { operations: [] };

/**
 * @param {CartInput} input
 * @returns {CartLinesDiscountsGenerateRunResult}
 */
export function cart_lines_discounts_generate_run(input) {
  // Sirf target collection ke variants filter karo
  const collectionLines = input.cart.lines.filter((line) => {
    return (
      line.merchandise.__typename === "ProductVariant" &&
      line.merchandise.product.inAnyCollection === true
    );
  });

  if (collectionLines.length === 0) {
    return EMPTY_DISCOUNT;
  }

  const totalQty = collectionLines.reduce((sum, line) => sum + line.quantity, 0);

  const tierTotal = TIER_TOTALS[totalQty];

  // Agar qty 2/4/6 nahi hai (yaani 1,3,5,7+ hai) -> koi discount nahi, base price chalega
  if (!tierTotal) {
    return EMPTY_DISCOUNT;
  }

  const currentSubtotal = totalQty * BASE_PRICE;
  const discountAmount = currentSubtotal - tierTotal;

  if (discountAmount <= 0) {
    return EMPTY_DISCOUNT;
  }

  // Collection ke bahar ke saare lines ko exclude karo, taki discount sirf inn print lines pe lage
  const collectionLineIds = new Set(collectionLines.map((l) => l.id));
  const excludedCartLineIds = input.cart.lines
    .filter((line) => !collectionLineIds.has(line.id))
    .map((line) => line.id);

  return {
    operations: [
      {
        orderDiscountsAdd: {
          selectionStrategy: OrderDiscountSelectionStrategy.First,
          candidates: [
            {
              message: `Print Collection Offer: ${totalQty} Prints @ Rs ${tierTotal.toLocaleString("en-IN")}`,
              targets: [
                {
                  orderSubtotal: {
                    excludedCartLineIds: excludedCartLineIds,
                  },
                },
              ],
              value: {
                fixedAmount: {
                  amount: discountAmount.toFixed(2),
                },
              },
            },
          ],
        },
      },
    ],
  };
}
```

